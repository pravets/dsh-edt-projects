{
  "name": "@local/dsh-edt-mcp",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "MCP hub for 1C development: EDT always on, BSL Language Server and a task tracker mounted on demand, with model-facing usage rules",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
