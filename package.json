{
  "name": "dsh-edt-plugin",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness bundle: MCP hub for 1C development with on-demand servers",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "edt-mcp"
  ],
  "scripts": {
    "validate": "node tools/validate-bundle.mjs",
    "validate:tag": "node tools/validate-bundle.mjs --tag",
    "check:edt": "node tools/check-edt-mcp.mjs",
    "smoke": "node tools/smoke-bundle.mjs",
    "test": "node tools/rules.test.mjs && node tools/bsl.test.mjs",
    "pack:check": "npm pack --workspace edt-mcp --dry-run --cache .npm-cache"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "yaml": "^2.8.1"
  }
}
